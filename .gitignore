# recastnavigation directory needs exception
!/dep/recastnavigation/RecastDemo/Build/

/src/tools/Extractor_Binaries/*.exe

# AI assistant scratch. Agent config belongs to the workspace, not to a core;
# docs/superpowers was a pure artifact (it ignored its own entire contents).
.claude/
docs/superpowers/

# Compiler caches. CCACHE_DIR/SCCACHE_DIR in the CI workflows point outside the
# checkout, which is the actual fix; this is a safety net, because the cache
# action picks its own directory if it does not honour those. Without it the
# "working tree is clean" guard fails on the cache rather than on a real change.
.ccache/
.sccache/

# Generated by GenRevision; 02 writes it to the build tree instead.
src/shared/revision_data.h

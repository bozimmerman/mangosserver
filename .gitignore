nbproject
Thumbs.db
.omo
.claude

# Configuration files to be customized

# Build directories. Anchored at the root: an unanchored "build" also swallows
# dep/recastnavigation/RecastDemo/Build on case-insensitive filesystems.
/bin/
_build
/build/
/install/
/database/

